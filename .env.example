# ============================================================
#  复制本文件为 .env（本地）或在 Vercel Dashboard 填入同名变量
#  ⚠️ .env 已被 .gitignore 忽略，真实密钥永远不要提交
# ============================================================

# ---- DeepSeek AI（AI 随手记 / 每日一句 / 邮件分析）----
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=


# ---- Vercel 部署 token（本地跑 deploy.sh 用，不要填进 Vercel）----
# 申请：https://vercel.com/account/tokens
VERCEL_TOKEN=

# ---- Cloudflare 部署（朋友版，通常用 wrangler 登录，不需要 token）----
CLOUDFLARE_API_TOKEN=
